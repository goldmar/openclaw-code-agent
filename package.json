{
  "name": "openclaw-code-agent",
  "version": "4.7.20",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "main": "dist/index.js",
  "scripts": {
    "audit:prod": "pnpm audit --prod",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && esbuild index.ts --bundle --splitting --platform=node --target=node24 --format=esm --outdir=dist --entry-names=index --chunk-names=chunks/[name]-[hash] --minify --charset=utf8 --pure:console.log --pure:console.warn --pure:console.info --pure:console.debug --external:@anthropic-ai/claude-agent-sdk --external:openclaw/plugin-sdk/plugin-entry --external:openclaw/plugin-sdk/channel-outbound --external:openclaw/plugin-sdk/json-store --external:openclaw/plugin-sdk/routing --external:openclaw/plugin-sdk/state-paths",
    "prepack": "pnpm build",
    "generate:npm-shrinkwrap": "node scripts/generate-npm-shrinkwrap.mjs",
    "check-static-guardrails": "node scripts/check-static-guardrails.mjs && node scripts/check-npm-shrinkwrap.mjs",
    "check-plugin-security": "node scripts/check-plugin-security.mjs",
    "check-clawhub-scan": "node scripts/check-clawhub-scan.mjs",
    "sync:codex-protocol": "node scripts/sync-codex-protocol.mjs",
    "sync:opencode-openapi": "node scripts/sync-opencode-openapi.mjs",
    "sync:clawhub-scan": "node scripts/sync-clawhub-scan.mjs",
    "test": "node scripts/run-tests.mjs",
    "coverage": "node scripts/coverage.mjs",
    "test:integ:crabbox": "node scripts/run-tests.mjs tests/oca-codex-crabbox-integ.test.ts tests/oca-plugin-workflows-integ.test.ts tests/oca-codex-telegram-proof.test.ts tests/oca-codex-proof-app-server.test.ts tests/oca-codex-proof-workflow.test.ts",
    "test:serial": "node scripts/run-tests.mjs",
    "test:file": "node scripts/run-tests.mjs",
    "smoke:backend": "node scripts/run-tests.mjs tests/codex-harness.test.ts tests/plan-mode-e2e.test.ts tests/session-restore-service.test.ts",
    "smoke:backend-parity": "node scripts/run-tests.mjs tests/backend-contract-smoke.test.ts tests/codex-harness.test.ts tests/harness-registry.test.ts",
    "smoke:codex-worktrees": "node scripts/run-tests.mjs tests/codex-harness.test.ts tests/session-bootstrap.test.ts tests/session-restore-service.test.ts",
    "smoke:codex-live": "OPENCLAW_RUN_LIVE_CODEX_SMOKE=1 node scripts/run-tests.mjs tests/live-codex-app-server-smoke.test.ts",
    "proof:codex-doctor": "node --import tsx scripts/e2e/oca-codex-telegram-proof.ts doctor",
    "proof:codex-local": "node --import tsx scripts/e2e/oca-codex-telegram-proof.ts local-smoke",
    "proof:codex-telegram": "node scripts/e2e/run-oca-codex-telegram-proof.mjs",
    "smoke:codex-release": "OPENCLAW_RUN_LIVE_CODEX_RELEASE_SMOKE=1 node scripts/run-tests.mjs tests/live-codex-app-server-smoke.test.ts",
    "smoke:opencode-live": "OPENCLAW_RUN_LIVE_OPENCODE_SMOKE=1 node scripts/run-tests.mjs tests/live-opencode-server-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "verify:npm-consumer": "node scripts/verify-npm-consumer-install.mjs",
    "verify": "pnpm check-static-guardrails && pnpm typecheck && pnpm build && pnpm check-clawhub-scan && pnpm test"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "openclaw-code-agent",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.6"
    },
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    }
  },
  "files": [
    "dist/",
    "skills/",
    "openclaw.plugin.json",
    "npm-shrinkwrap.json",
    "README.md",
    "docs/SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@anthropic-ai/sdk": "0.127.0",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express-rate-limit": "8.7.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "qs": "6.16.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.10.2",
    "openclaw": "2026.9.6",
    "tsx": "^4.21.0",
    "typebox": "1.3.30",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "claude",
    "claude-code",
    "opencode",
    "coding-agent",
    "codex",
    "openai",
    "ai",
    "anthropic",
    "agent",
    "code-generation",
    "automation",
    "orchestration",
    "git-worktree",
    "pull-request",
    "background-process",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goldmar/openclaw-code-agent.git"
  },
  "homepage": "https://github.com/goldmar/openclaw-code-agent#readme",
  "bugs": {
    "url": "https://github.com/goldmar/openclaw-code-agent/issues"
  },
  "license": "MIT",
  "author": "Mark Goldenstein",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "description": "OpenClaw plugin that runs Claude Code, Codex, and experimental OpenCode as managed background coding sessions from chat, with plan approval, isolated git worktrees, and merge/PR follow-through.",
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  }
}
